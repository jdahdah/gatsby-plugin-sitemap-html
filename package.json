{
  "name": "gatsby-plugin-sitemap-html",
  "version": "1.2.2",
  "description": "Gatsby plugin that extends gatsby-plugin-sitemap to generate HTML-styled sitemaps using XSL",
  "main": "gatsby-node.js",
  "types": "gatsby-node.d.ts",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "babel src -d .",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "prepare": "cross-env NODE_ENV=production pnpm run build && husky install"
  },
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "sitemap",
    "sitemap-xml",
    "xsl",
    "xslt",
    "html-sitemap",
    "seo",
    "search-engine-optimization",
    "xml-sitemap",
    "styled-sitemap",
    "human-readable"
  ],
  "author": {
    "name": "Ketan",
    "url": "https://github.com/KtanPatel"
  },
  "license": "MIT",
  "dependencies": {
    "fs-extra": "^11.3.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "babel-preset-gatsby-package": "^3.16.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "gatsby": "^5.16.1",
    "gatsby-plugin-sitemap": "^6.16.0"
  },
  "files": [
    "index.js",
    "gatsby-node.js",
    "gatsby-node.d.ts",
    "templates/sitemap.xsl",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KtanPatel/gatsby-plugin-sitemap-html.git"
  },
  "homepage": "https://github.com/KtanPatel/gatsby-plugin-sitemap-html#readme",
  "bugs": {
    "url": "https://github.com/KtanPatel/gatsby-plugin-sitemap-html/issues"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/KtanPatel"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
